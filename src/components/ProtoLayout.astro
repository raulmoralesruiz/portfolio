---
import '../styles/global.css';

interface Props {
  title: string;
  /** Tema Adelante: "dark" marca <html data-theme="dark"> (por defecto: claro). */
  theme?: "light" | "dark";
}
const { title, theme = "light" } = Astro.props;
---

<!doctype html>
<html lang="es" class="dark" data-theme={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <script is:inline>
      // Antes del primer paint (sin flash):
      //  1) marca <html class="js"> para que el CSS sepa que hay JS
      //  2) aplica el tema guardado
      (function () {
        document.documentElement.classList.add("js");
        try {
          var t = localStorage.getItem("at-theme");
          if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="bg-neutral-950 text-gray-200 font-sans antialiased min-h-screen">
    <slot />
  </body>
</html>
