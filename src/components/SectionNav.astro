---
import type { Lang } from "../data/cv";
import { getSections } from "../utils/sections";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const sections = getSections(lang);

const toggleActive = "px-2 py-1 rounded text-emerald-400 bg-emerald-400/10";
const toggleInactive = "px-2 py-1 rounded text-gray-500 hover:text-gray-300 transition-colors";
---

<header class="fixed top-0 inset-x-0 z-50 bg-neutral-950/90 backdrop-blur border-b border-neutral-800">
  <div class="max-w-4xl mx-auto h-14 px-4 flex items-center gap-3">
    <nav class="flex-1 min-w-0" aria-label={lang === "es" ? "Secciones" : "Sections"}>
      <ul class="flex items-center gap-0.5 overflow-x-auto">
        {sections.map((section) => (
          <li class="shrink-0">
            <a
              href={`#${section.anchor}`}
              data-section-link
              class="px-1.5 py-1 rounded font-mono text-xs whitespace-nowrap text-neutral-500 hover:text-neutral-300 transition-colors"
            >
              <span class="opacity-70">{section.num}</span>
              <span class="hidden md:inline"> {section.label}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav
      class="flex items-center gap-1 border border-neutral-800 rounded p-1 font-mono text-xs shrink-0"
      aria-label="Language"
    >
      <a href="/" class={lang === "es" ? toggleActive : toggleInactive} aria-current={lang === "es" ? "true" : undefined}>ES</a>
      <a href="/en/" class={lang === "en" ? toggleActive : toggleInactive} aria-current={lang === "en" ? "true" : undefined}>EN</a>
    </nav>
  </div>
</header>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-section-link]"));

  if (links.length > 0) {
    const sections = links
      .map((link) => document.getElementById(link.getAttribute("href")?.slice(1) ?? ""))
      .filter((el): el is HTMLElement => el !== null);

    const INACTIVE = ["text-neutral-500", "hover:text-neutral-300"];
    const ACTIVE = ["text-emerald-400"];
    let activeId: string | null = null;
    const visible = new Map<string, number>();

    const applyState = (link: HTMLAnchorElement, isActive: boolean) => {
      for (const cls of INACTIVE) link.classList.toggle(cls, !isActive);
      for (const cls of ACTIVE) link.classList.toggle(cls, isActive);
      if (isActive) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    };

    const setActive = (id: string) => {
      if (id === activeId) return;
      activeId = id;
      for (const link of links) applyState(link, link.getAttribute("href") === `#${id}`);
    };

    // Scrollspy: a section is "current" when it enters the top 45% of the
    // viewport; among visible ones, the most recently entered wins.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.set(entry.target.id, entry.boundingClientRect.top);
          else visible.delete(entry.target.id);
        }
        if (visible.size === 0) return;
        let best = "";
        let bestTop = -Infinity;
        for (const [id, top] of visible) {
          if (top > bestTop) {
            bestTop = top;
            best = id;
          }
        }
        setActive(best);
      },
      { rootMargin: "0px 0px -55% 0px", threshold: 0 }
    );

    for (const section of sections) observer.observe(section);
  }
</script>
