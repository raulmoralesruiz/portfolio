---
import { cv, type Lang } from "../data/cv";
import { getSection } from "../utils/sections";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = cv[lang].ui;
const section = getSection(lang, "contact");
const email = cv[lang].email;
---

<section
 id={cv[lang].anchors.contact}
 class="py-24 text-center container mx-auto px-4 max-w-4xl">
 <h2 class="text-4xl md:text-5xl font-bold text-white mb-6 flex justify-center items-center">
  <span class="text-emerald-400 mr-3 font-mono text-3xl">{section.num}.</span> {ui.contactTitle}
 </h2>
 <p class="text-gray-400 text-lg mb-12 max-w-xl mx-auto leading-relaxed">
  {ui.contactBody}
 </p>
 <div class="inline-flex flex-wrap items-center justify-center gap-3 border border-neutral-800 rounded px-4 py-3 mb-6">
  <span class="font-mono text-gray-300 select-all">{email}</span>
  <button
   id="copy-email"
   type="button"
   data-email={email}
   data-copied={ui.emailCopied}
   data-error={ui.emailCopyError}
   class="inline-flex items-center justify-center min-h-11 font-mono text-sm px-3 py-1.5 rounded border border-neutral-700 text-gray-400 hover:border-emerald-400 hover:text-emerald-400 transition-colors cursor-pointer">
   {ui.copyEmail}
  </button>
 </div>
 <p id="copy-email-status" class="sr-only" aria-live="polite"></p>
 <a
  href={`mailto:${email}`}
  class="inline-block border border-emerald-400 text-emerald-400 px-8 py-4 rounded font-mono hover:bg-emerald-400/10 transition-colors">
  {ui.contactCta}
 </a>

 <div class="mt-20 flex justify-center gap-8">
  <a
   href="https://github.com/raulmoralesruiz"
   target="_blank"
   rel="noopener noreferrer"
   class="inline-flex items-center justify-center min-w-11 min-h-11 text-gray-400 hover:text-emerald-400 transition-colors">
   <span class="sr-only">GitHub</span>
   <svg
    class="w-6 h-6"
    fill="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
    ><path
     fill-rule="evenodd"
     d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
     clip-rule="evenodd"></path></svg
   >
  </a>
  <a
   href="https://www.linkedin.com/in/raulmoralesruiz"
   target="_blank"
   rel="noopener noreferrer"
   class="inline-flex items-center justify-center min-w-11 min-h-11 text-gray-400 hover:text-emerald-400 transition-colors">
   <span class="sr-only">LinkedIn</span>
   <svg
    class="w-6 h-6"
    fill="currentColor"
    viewBox="0 0 24 24"
    aria-hidden="true"
    ><path
     fill-rule="evenodd"
     d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"
     clip-rule="evenodd"></path></svg
   >
  </a>
 </div>

 <footer
  class="mt-20 border-t border-neutral-800 pt-8 pb-4 font-mono text-sm">
  <div class="flex flex-col items-center justify-between gap-3 sm:flex-row">
   <p class="text-neutral-400">{ui.footer}</p>
   <div class="flex items-center gap-2 text-neutral-400">
    <a href="https://raulmorales.eu" class="inline-flex items-center min-h-11 hover:text-emerald-400 transition-colors">raulmorales.eu</a>
    <span aria-hidden="true" class="inline-flex items-center min-h-11">·</span>
    <span class="inline-flex items-center min-h-11">© {new Date().getFullYear()}</span>
    <a href="#top" class="inline-flex items-center justify-center min-w-11 min-h-11 text-emerald-400 hover:text-emerald-300 transition-colors" aria-label={lang === "es" ? "Volver arriba" : "Back to top"}>↑</a>
   </div>
  </div>
 </footer>
</section>

<script>
 const btn = document.getElementById("copy-email") as HTMLButtonElement | null;
 if (btn) {
  const email = btn.dataset.email ?? "";
  const label = btn.textContent ?? "";
  const copied = btn.dataset.copied ?? "";
  const failed = btn.dataset.error ?? "";
  const status = document.getElementById("copy-email-status");
  let timer: number | undefined;

  const flash = (msg: string) => {
   btn.textContent = msg;
   if (status) status.textContent = msg;
   window.clearTimeout(timer);
   timer = window.setTimeout(() => {
    btn.textContent = label;
    if (status) status.textContent = "";
   }, 2000);
  };

  btn.addEventListener("click", async () => {
   let ok: boolean;
   try {
    await navigator.clipboard.writeText(email);
    ok = true;
   } catch {
    const ta = document.createElement("textarea");
    ta.value = email;
    ta.style.position = "fixed";
    ta.style.opacity = "0";
    document.body.appendChild(ta);
    ta.select();
    try {
     ok = document.execCommand("copy");
    } catch {
     ok = false;
    }
    ta.remove();
   }
   flash(ok ? copied : failed);
  });
 }
</script>
