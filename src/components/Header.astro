---
import { cv, type Lang } from "../data/cv";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const data = cv[lang];
const ui = data.ui;
---

<section id="top" class="min-h-svh flex flex-col justify-center container mx-auto px-4 max-w-6xl pt-16">
  <div class="grid lg:grid-cols-[3fr_2fr] gap-12 items-center">
    <div class="flex flex-col items-start">
      <span class="text-emerald-400 font-mono tracking-wider mb-4">{ui.greeting}</span>
      <h1 class="text-5xl md:text-7xl font-bold text-white mb-4">
        {data.header.name}
      </h1>
      <h2 class="text-4xl md:text-5xl font-bold text-gray-400 mb-6">
        {data.header.role}<span class="hero-cursor" aria-hidden="true">▊</span>
      </h2>
      <p class="text-xl text-gray-400 max-w-xl leading-relaxed mb-8" set:html={data.header.description.replace('Full-Stack', '<span class="text-emerald-400">Full-Stack</span>')} />
      <div class="flex flex-wrap gap-4">
        <a href={`#${data.anchors.projects}`} class="inline-block border border-emerald-400 text-emerald-400 px-8 py-4 rounded font-mono hover:bg-emerald-400/10 transition-colors">
          {ui.viewProjects}
        </a>
        <button
          id="download-cv"
          data-lang={lang}
          class="inline-flex items-center gap-2 border border-white text-white px-8 py-4 rounded font-mono hover:bg-white/10 transition-colors cursor-pointer">
          <span class="text-emerald-400" aria-hidden="true">$</span>
          <span>{ui.download} {ui.cvFile}</span>
        </button>
      </div>
      <p id="cv-status" class="mt-4 min-h-5 font-mono text-sm" aria-live="polite"></p>
      <p class="mt-2 font-mono text-xs text-gray-400 max-w-md">{ui.cvCaption}</p>
    </div>
    <div class="hidden lg:block">
      <div class="rounded-lg border border-neutral-800 bg-neutral-900/50 overflow-hidden">
        <div class="flex items-center gap-2 px-4 py-2.5 border-b border-neutral-800">
          <span class="w-3 h-3 rounded-full bg-neutral-700" aria-hidden="true"></span>
          <span class="w-3 h-3 rounded-full bg-neutral-700" aria-hidden="true"></span>
          <span class="w-3 h-3 rounded-full bg-neutral-700" aria-hidden="true"></span>
          <span class="ml-2 font-mono text-xs text-gray-500">raul@portfolio:~</span>
        </div>
        <div class="p-5 font-mono text-sm leading-relaxed">
          <p class="text-gray-300"><span class="text-emerald-400 select-none" aria-hidden="true">$</span> <span class="text-gray-400">{ui.heroTerminalCmd}</span></p>
          <ul class="mt-3 space-y-1.5">
            {data.projects.map((p) => (
              <li class="text-gray-400"><span class="text-emerald-400 select-none" aria-hidden="true">▹</span> {p.title}</li>
            ))}
          </ul>
          <p class="mt-3 text-gray-300"><span class="text-emerald-400 select-none" aria-hidden="true">$</span> <span class="hero-cursor" aria-hidden="true">▊</span></p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { generateWordDocument } from "../utils/wordExport";
  import { cv } from "../data/cv";
  import type { Lang } from "../data/cv";

  const downloadBtn = document.getElementById('download-cv') as HTMLButtonElement | null;
  const lang = (downloadBtn?.dataset.lang as Lang) || 'es';
  const ui = cv[lang].ui;
  const statusEl = document.getElementById('cv-status') as HTMLElement | null;
  const TONES = ["text-gray-400", "text-emerald-400", "text-gray-300"];

  function setStatus(text: string, tone: string) {
    if (!statusEl) return;
    TONES.forEach((t) => statusEl.classList.remove(t));
    statusEl.textContent = text;
    statusEl.classList.add(tone);
  }

  if (downloadBtn) {
    downloadBtn.addEventListener('click', async () => {
      try {
        setStatus(`$ ${ui.generating}`, "text-gray-400");
        downloadBtn.classList.add('opacity-70', 'cursor-not-allowed');
        downloadBtn.disabled = true;

        const blob = await generateWordDocument(lang);

        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = ui.cvFile;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);

        setStatus(`✓ ${ui.cvFile} ${ui.cvDone}`, "text-emerald-400");
      } catch (error) {
        console.error('Error generando CV:', error);
        setStatus(`✗ ${ui.cvError}`, "text-gray-300");
      } finally {
        downloadBtn.classList.remove('opacity-70', 'cursor-not-allowed');
        downloadBtn.disabled = false;
      }
    });
  }
</script>
