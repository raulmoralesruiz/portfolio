---
import '../styles/global.css';
import type { Lang } from '../data/cv';

interface Props {
  lang: Lang;
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;

const SITE = 'https://portfolio.raulmorales.eu';
// ES/EN viven en pares: / ↔ /en/.
const { pathname } = Astro.url;
const esPath = pathname.replace(/\/en\/?$/, '/');
const enPath = pathname.endsWith('en/') ? pathname : `${pathname.replace(/\/?$/, '/')}en/`;
const esUrl = `${SITE}${esPath}`;
const enUrl = `${SITE}${enPath}`;
const currentUrl = lang === 'es' ? esUrl : enUrl;

// Structured data (schema.org Person) para SEO / rich results.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Raúl Morales",
  url: SITE,
  jobTitle: "Frontend Developer",
  email: "mailto:raulmoralesruiz@outlook.com",
  image: `${SITE}/og-image.png`,
  description,
  sameAs: [
    "https://github.com/raulmoralesruiz",
    "https://www.linkedin.com/in/raulmoralesruiz",
  ],
  knowsAbout: ["Angular", "HTML", "CSS", "JavaScript", "TypeScript", "Astro", "Tailwind"],
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- El "chrome" del navegador móvil sigue el tema (oscuro por defecto; el
         toggle lo actualiza a crema). -->
    <meta name="theme-color" content="#001515" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- Fraunces (fuente del hero/LCP): preload para reducir el FOUT. Solo la
         normal (la itálica no es crítica para LCP; prelastrarla gastaría banda). -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fuentes/fraunces-latin-normal.woff2" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />
    <link rel="canonical" href={currentUrl} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Raúl Morales" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:image" content={`${SITE}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Raúl Morales — Frontend Developer" />
    <meta name="twitter:card" content="summary_large_image" />
    <!-- Structured data: schema.org Person (SEO / rich results) -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <script is:inline>
      // Antes del primer paint (sin flash):
      //  1) marca <html class="js"> para que el CSS sepa que hay JS (animaciones de reveal)
      //  2) aplica el tema guardado (oscuro por defecto; "light" si el usuario lo eligió)
      (function () {
        document.documentElement.classList.add("js");
        try {
          const t = localStorage.getItem("at-theme");
          if (t === "dark" || t === "light") document.documentElement.dataset.theme = t;
        } catch { /* storage bloqueado: queda el tema por defecto (oscuro) */ }
      })();
    </script>
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
