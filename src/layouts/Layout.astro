---
import '../styles/global.css';
import type { Lang } from '../data/cv';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** true → noindex/nofollow (páginas archivadas, p. ej. /original/). */
  noindex?: boolean;
}

const { lang, title, description, noindex = false } = Astro.props;

const SITE = 'https://portfolio.raulmorales.eu';
// ES/EN viven en pares: / ↔ /en/, /original/ ↔ /original/en/.
const { pathname } = Astro.url;
const esPath = pathname.replace(/\/en\/?$/, '/');
const enPath = pathname.endsWith('en/') ? pathname : `${pathname.replace(/\/?$/, '/')}en/`;
const esUrl = `${SITE}${esPath}`;
const enUrl = `${SITE}${enPath}`;
const currentUrl = lang === 'es' ? esUrl : enUrl;
---

<!doctype html>
<html lang={lang} class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {noindex
      ? <meta name="robots" content="noindex, nofollow" />
      : <>
        <link rel="alternate" hreflang="es" href={esUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={esUrl} />
      </>}
    <link rel="canonical" href={currentUrl} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Raúl Morales" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={currentUrl} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:image" content={`${SITE}/og-image.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Raúl Morales — Frontend Developer" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-neutral-950 text-gray-200 font-sans antialiased selection:bg-emerald-500/30 selection:text-emerald-300">
    <slot />
  </body>
</html>
