---
import Layout from "../../layouts/Layout.astro";
import SectionNav from "../../components/SectionNav.astro";
import Header from "../../components/Header.astro";
import About from "../../components/About.astro";
import Skills from "../../components/Skills.astro";
import Projects from "../../components/Projects.astro";
import Experience from "../../components/Experience.astro";
import Education from "../../components/Education.astro";
import Certifications from "../../components/Certifications.astro";
import Contact from "../../components/Contact.astro";
import { cv } from "../../data/cv";

const lang = "en" as const;
const data = cv[lang];
---

<Layout lang={lang} title={data.pageTitle} description={data.metaDescription}>
  <a href="#main" class="skip-link">{data.ui.skipToContent}</a>
  <SectionNav lang={lang} />
  <main id="main" tabindex="-1" class="flex flex-col outline-none">
    <Header lang={lang} />
    <About lang={lang} />
    <Skills lang={lang} />
    <Projects lang={lang} />
    <Experience lang={lang} />
    <Education lang={lang} />
    <Certifications lang={lang} />
    <Contact lang={lang} />
  </main>
</Layout>
