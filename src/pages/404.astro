---
import AdelanteLayout from "../layouts/AdelanteLayout.astro";
import "../styles/adelante.css";

const title = "404 — No se encontró la ruta";
const description =
  "La ruta que buscas no existe. / The page you're looking for doesn't exist.";

/* Los 7 tiles del hero (firma visual del diseño). En desktop se reparten
   en dos tiras verticales a los lados del mensaje: izquierda (4) y
   derecha (3); en móvil, ocultas para que la página quepa sin scroll. */
const TILES = [
  `<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet"><rect width="48" height="48" fill="#FAF3E0"/><path d="M18 6h12v12h12v12H30v12H18V30H6V18h12z" fill="#24C87F"/><path d="M0 -7 7 0 0 7 -7 0z M48 -7 55 0 48 7 41 0z M0 41 7 48 0 55 -7 48z M48 41 55 48 48 55 41 48z" fill="#004242"/><rect x="21" y="21" width="6" height="6" fill="#FAF3E0" transform="rotate(45 24 24)"/></svg>`,
  `<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet"><rect width="48" height="48" fill="#FAF3E0"/><rect x="12" y="12" width="24" height="24" fill="#FFC233" transform="rotate(45 24 24)"/><rect x="19" y="19" width="10" height="10" fill="#004242" transform="rotate(45 24 24)"/></svg>`,
  `<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet"><rect width="48" height="48" fill="#004242"/><g fill="none" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 16h8l6-8h8l6 8h12" stroke="#00FF8D"/><path d="M4 34h8l6-8h8l6 8h12" stroke="#24C87F"/></g></svg>`,
  `<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet"><rect width="48" height="48" fill="#FAF3E0"/><circle cx="24" cy="24" r="14" fill="#004242"/><circle cx="24" cy="24" r="6" fill="#24C87F"/></svg>`,
  `<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet"><rect width="48" height="48" fill="#FAF3E0"/><g fill="#24C87F"><rect x="20" y="6" width="8" height="36"/><rect x="6" y="20" width="36" height="8"/></g><g fill="#004242"><rect x="22" y="8" width="4" height="32"/><rect x="8" y="22" width="32" height="4"/></g></svg>`,
  `<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet"><rect width="48" height="48" fill="#FAF3E0"/><g fill="none" stroke="#FFC233" stroke-width="5" stroke-linecap="round"><path d="M6 18c4-6 8-6 12 0s8 6 12 0 8-6 12 0"/><path d="M6 32c4-6 8-6 12 0s8 6 12 0 8-6 12 0"/></g></svg>`,
  `<svg viewBox="0 0 48 48" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet"><rect width="48" height="48" fill="#24C87F"/><g fill="#004242"><rect x="8" y="8" width="12" height="12"/><rect x="28" y="28" width="12" height="12"/></g><g fill="#FAF3E0"><rect x="28" y="8" width="12" height="12"/><rect x="8" y="28" width="12" height="12"/></g></svg>`,
];
---

<AdelanteLayout lang="es" title={title} description={description}>
  <!-- Fija la página a la viewport: cabe sin scroll; las tiras de tiles
       se dimensionan en vh para que también quepan en pantallas bajas. -->
  <div class="at h-svh overflow-hidden flex flex-col">
    <!-- Cabecera de marca (mismo lenguaje que la nav del sitio) -->
    <header class="border-b-[3px] border-[var(--at-ink)]">
      <div class="max-w-6xl mx-auto px-4 py-3 flex items-center gap-3">
        <span class="at-card at-card-green inline-flex items-center justify-center w-10 h-10 at-display text-xl">RM</span>
        <span class="at-display text-lg">Raúl Morales</span>
      </div>
    </header>

    <main class="flex-1 min-h-0 flex items-center justify-center gap-6 lg:gap-8 px-4 py-10 md:py-14">
      <!-- Tira izquierda: 4 baldosas (firma visual, decorativa; visible solo en lg+) -->
      <div class="at-tiles at-tiles--col w-[clamp(88px,12.5vh,150px)]" aria-hidden="true">
        {TILES.slice(0, 4).map((t) => <span set:html={t} />)}
      </div>

      <div class="flex flex-col items-center text-center min-w-0">
        <p class="at-eyebrow mb-6">Error · Error</p>
        <h1 class="at-display text-[clamp(4rem,13vw,8rem)] whitespace-nowrap mb-5" aria-label="404">
          <span class="at-mark">4<svg class="at-trazo" viewBox="0 0 200 20" preserveAspectRatio="none" aria-hidden="true"><path d="M3 12 C 60 3, 140 18, 197 7" pathLength="1" /></svg></span>04
        </h1>
        <p class="text-lg md:text-xl leading-relaxed max-w-xl mb-2">
          La ruta que buscas no existe — o todavía no se ha construido.
        </p>
        <p class="text-base md:text-lg opacity-70 max-w-xl mb-8">
          The page you're looking for doesn't exist — or it hasn't been built yet.
        </p>
        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/" class="at-btn at-btn-solid">← Volver al inicio (ES)</a>
          <a href="/en/" class="at-btn at-btn-amber">← Back to home (EN)</a>
        </div>
      </div>

      <!-- Tira derecha: 3 baldosas (firma visual, decorativa; visible solo en lg+) -->
      <div class="at-tiles at-tiles--col w-[clamp(88px,12.5vh,150px)]" aria-hidden="true">
        {TILES.slice(4, 7).map((t) => <span set:html={t} />)}
      </div>
    </main>
  </div>
</AdelanteLayout>
