---
import Layout from "../layouts/Layout.astro";

const title = "404 — No se encontró la ruta";
const description =
  "La ruta que buscas no existe. / The page you're looking for doesn't exist.";
---

<Layout lang="es" title={title} description={description}>
  <main
    class="min-h-svh flex flex-col items-center justify-center container mx-auto px-4 text-center">
    <p class="font-mono text-emerald-400 text-sm mb-8" aria-hidden="true">
      $ ls /ruta-inexistente
    </p>
    <h1 class="text-8xl md:text-9xl font-bold text-white mb-4">404</h1>
    <p class="text-lg text-gray-300 mb-1">
      No se encontró la ruta que buscas.
    </p>
    <p class="text-lg text-gray-400 mb-10">
      The page you're looking for doesn't exist.
    </p>
    <div class="flex flex-col sm:flex-row gap-4">
      <a
        href="/"
        class="inline-flex items-center justify-center min-h-11 border border-emerald-400 text-emerald-400 px-8 py-4 rounded font-mono hover:bg-emerald-400/10 transition-colors">
        ← Volver al inicio (ES)
      </a>
      <a
        href="/en/"
        class="inline-flex items-center justify-center min-h-11 border border-white text-white px-8 py-4 rounded font-mono hover:bg-white/10 transition-colors">
        ← Back to home (EN)
      </a>
    </div>
  </main>
</Layout>
